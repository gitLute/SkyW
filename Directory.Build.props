<Project>

  <!--
    Общие настройки всех проектов SkyW.
    Основание: docs/stack-constraints.md раздел 10 (обязательный целевой фреймворк,
    запрет триминга, запрет AllowUnsafeBlocks) и docs/engine-architecture.md раздел 1
    (имена интерфейсов, отсутствие проникновения внешних библиотек в прикладной код).
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <PropertyGroup Label="Среда выполнения">
    <!-- JoltPhysicsSharp 2.23.0 публикуется только под net9.0 и net10.0. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <PropertyGroup Label="Ограничения сборки">
    <!-- Нативные .so из JoltPhysics.Native тримить нельзя: docs/stack-constraints.md раздел 10. -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <!-- docs/stack-constraints.md раздел 6: проект собирается без AllowUnsafeBlocks. -->
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

</Project>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SkyW.Scenes</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../SkyW.Abstractions/SkyW.Abstractions.csproj" />
    <ProjectReference Include="../SkyW.Content/SkyW.Content.csproj" />
    <ProjectReference Include="../SkyW.Ecs/SkyW.Ecs.csproj" />
    <ProjectReference Include="../SkyW.Mathematics/SkyW.Mathematics.csproj" />
  </ItemGroup>

  <!--
    Слой 2. Сцена — данные и скрипты сборки, а не код движка: движок не содержит
    знаний о конкретных сценах и типах объектов (docs/engine-architecture.md раздел 4.1).

    Подтяжка через регистры, без рефлексии (раздел 4.2). Имя в регистре — единственный
    контракт между скриптом и движком; опечатка обязана обнаруживаться при старте.

    Каталоги внутри:
      Registries/  ComponentRegistry, SystemRegistry, MethodHandlerRegistry,
                   дескрипторы репликации, проверка имён
      Prefabs/     Prefab, PrefabManager: исполняемые определения, печка в Build,
                   граф вызовов, валидация до загрузки сцены
      Building/    SceneBuilder, SceneContext: builder-права без доступа к миру
      Streaming/   загрузка по зонам, освобождение памяти при уходе
      Scripts/     ISceneScript, ScriptHost: генератор сцены и префабы — скрипты одного типа
  -->

</Project>